{
  "name": "expense-tracker",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "electron": "electron ./electron/main.js",
    "electron:build": "expo export --platform web && electron-builder --config electron-builder.json",
    "electron:build:win": "expo export --platform web && electron-builder --config electron-builder.json --win",
    "electron:build:mac": "expo export --platform web && electron-builder --config electron-builder.json --mac",
    "electron:build:linux": "expo export --platform web && electron-builder --config electron-builder.json --linux",
    "screenshots:marketing": "node scripts/capture-marketing-screenshots.mjs",
    "screenshots:marketing:dark": "node scripts/capture-marketing-screenshots.mjs --dark",
    "test": "node --no-warnings --import ./tests/register.mjs --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@expo-google-fonts/cascadia-code": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "expo": "^57.0.24",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-pdf-text-extract": "^1.1.0",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-speech-recognition": "3.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "pdfjs-dist": "^3.11.174",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "xlsx": "^0.18.5"
  },
  "private": true,
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "expo-dev-client": "~57.0.19",
    "playwright": "^1.49.1"
  }
}
