{
  "appId": "com.giridharan19.expensetracker.desktop",
  "productName": "Worth",
  "copyright": "Copyright © 2026",
  "directories": {
    "output": "dist-desktop",
    "buildResources": "assets"
  },
  "files": [
    "electron/**/*",
    "dist/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "asar": true,
  "win": {
    "target": ["nsis"],
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "shortcutName": "Worth"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.finance",
    "icon": "assets/icon.png"
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Finance",
    "icon": "assets/icon.png"
  }
}
