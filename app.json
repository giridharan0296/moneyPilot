{
  "expo": {
    "name": "MoneyPilot",
    "slug": "expense-tracker",
    "owner": "giridharan19",
    "version": "1.0.0",
    "scheme": "worth",
    "orientation": "portrait",
    "icon": "./assets/worth-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to recognize your speech and turn it into transactions.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to hear your voice for auto-filling transactions."
      }
    },
    "android": {
      "versionCode": 3,
      "package": "com.giridharan19.expensetracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0B1220"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record voice notes for your transactions."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to hear your voice for auto-filling transactions.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to recognize your speech and turn it into transactions."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to photograph store bills so it can fill in an expense.",
          "photosPermission": "Allow $(PRODUCT_NAME) to read store bill photos you choose so it can fill in an expense."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/worth-splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220",
          "dark": {
            "image": "./assets/worth-splash-icon.png",
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "d393366d-2ad1-4564-a445-b692100d4a31"
      },
      "googleAuth": {
        "webClientId": "341507457215-lshv5b5rlkclhip5th2j6nns410jo881.apps.googleusercontent.com",
        "iosClientId": "",
        "androidClientId": "341507457215-litmc258a01n51sq80ua28m3n4p8sf6o.apps.googleusercontent.com"
      }
    }
  }
}
